# Local Figma API credentials (Cursor + Claude Code MCP)
# ---------------------------------------------------------------------------
# 1) Copy this file (do NOT commit the copy):
#      cp secrets/figma.example.env secrets/figma.env
# 2) Paste the QA Figma personal access token into FIGMA_ACCESS_TOKEN
# 3) Restart Cursor / Claude Code so the figma-qa MCP server reloads
#
# secrets/figma.env is gitignored via /secrets/* — never push real tokens.
# Create the token in Figma → Settings → Security → Personal access tokens
# (read-only scopes; see docs/ai/figma-setup.md).
# ---------------------------------------------------------------------------

FIGMA_ACCESS_TOKEN=your-figma-personal-access-token-here
