# Local Platform Jira / Zephyr Scale ATM credentials
# ---------------------------------------------------------------------------
# 1) Copy this file (do NOT commit the copy):
#      cp secrets/jira_atm.example.env secrets/jira_atm.env
# 2) Paste YOUR Personal Access Token into JIRA_TOKEN (each teammate uses their own)
# 3) scripts/zephyr_sync.py and the result collector load this automatically
#    Result push attributes executions to whoever owns this token — do not share PATs
#
# secrets/jira_atm.env is gitignored via /secrets/* — never push real tokens.
# ---------------------------------------------------------------------------

JIRA_ATM=https://jira.demo-platform.net/rest/atm/1.0
JIRA_TOKEN=your-jira-personal-access-token-here

# Optional default folder for result-collector cycles (not required for sync):
# ZEPHYR_CYCLE_FOLDER=/Bill/TCI
# Optional Zephyr environment name — must already exist on the project
# (ALPHA today: PWA-Stage, BackEnd-Stage). Leave unset to skip.
# ZEPHYR_ENVIRONMENT=PWA-Stage
#
# Result-push mode (set per run; do not leave override sticky in this file):
#   create   = new cycle (default; first push for a slice)
#   override = PUT results onto ZEPHYR_CYCLE_KEY (ask the human first)
# ZEPHYR_CYCLE_MODE=create
# ZEPHYR_CYCLE_KEY=ALPHA-C##
